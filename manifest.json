{
  "name": "Tablytics",
  "description": "Examine how many rounds a judge has judged on Tabroom, alongside their aff/neg voting percentages.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "tablytics_icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tabroom.com/index/paradigm.mhtml*",
        "https://tabroom.com/index/paradigm.mhtml*"
      ],
      "js": [
        "scripts/content.js"
      ]
    }
  ]
}
